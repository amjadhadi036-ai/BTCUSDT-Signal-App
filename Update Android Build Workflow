<div class="row"><span>Funding Sentiment</span><b id="fundingMood">--</b></div>
</div>

<div class="card">
<h3>BlackRock IBIT Analysis</h3>
<div class="row"><span>Bitcoin Holdings</span><b id="ibitBTC">--</b></div>
<div class="row"><span>پچھلا محفوظ ڈیٹا</span><b id="previousBTC">--</b></div>
<div class="row"><span>Holdings میں تبدیلی</span><b id="ibitChange">--</b></div>
<div class="row"><span>اندازاً USD تبدیلی</span><b id="ibitUSD">--</b></div>
<div class="row"><span>ڈیٹا کی حالت</span><b id="ibitStatus">چیک ہو رہا ہے</b></div>
<p class="small">یہ پبلک ہولڈنگز کا تخمینہ ہے، BlackRock کے حقیقی روزانہ Net Cash Inflow یا Outflow کا متبادل نہیں۔</p>
</div>

<div class="card">
<h3>Bloomberg Market Reference</h3>
<div class="row"><span>Benchmark Reference</span><b>BRRNY</b></div>
<div class="row"><span>Live Bloomberg Feed</span><b class="yellow">منسلک نہیں</b></div>
<p class="small">Bloomberg Terminal کا اصل ڈیٹا دکھانے کے لیے مجاز Bloomberg اکاؤنٹ، API اور انٹرنیٹ پر محفوظ سرور درکار ہے۔ یہ صرف Benchmark Reference ہے، Live Bloomberg Data نہیں۔</p>
</div>

<div class="card">
<h3>Risk Management</h3>
<div class="row"><span>Account Balance</span><b>102 USDT</b></div>
<div class="row"><span>Leverage Reference</span><b>5x</b></div>
<div class="row"><span>Risk Per Trade</span><b>0.51 USDT</b></div>
<div class="row"><span>Maximum Notional</span><b>85 USDT</b></div>
<p class="small">یہ صرف رسک کی معلومات ہیں۔ ایپ خود کوئی ٹریڈ نہیں لگاتی۔</p>
</div>

<div class="card">
<h3>System Status</h3>
<div class="row"><span>Binance Data</span><b id="connection">Connecting...</b></div>
<div class="row"><span>Last Signal Update</span><b id="signalTime">--</b></div>
<div class="row"><span>Auto Refresh</span><b class="green">15 Seconds</b></div>
<button onclick="refreshAll()">ابھی ڈیٹا اپ ڈیٹ کریں</button>
</div>

<p class="small" style="text-align:center">یہ سافٹ ویئر تعلیمی تجزیے کے لیے ہے۔ سگنل منافع کی ضمانت نہیں۔</p>

<script>
const API="https://fapi.binance.com";
let currentPrice=0;
let lastMinutePrice=0;
let lastSignal="NO TRADE";

function fmt(n,d=2){
 if(!Number.isFinite(Number(n))) return "--";
 return Number(n).toLocaleString("en-US",{maximumFractionDigits:d});
}

async function getJSON(url){
 const r=await fetch(url,{cache:"no-store"});
 if(!r.ok) throw new Error("HTTP "+r.status);
 return await r.json();
}

function ema(values,period){
 if(values.length<period)return NaN;
 let k=2/(period+1);
 let e=values[0];
 for(let i=1;i<values.length;i++){
  e=values[i]*k+e*(1-k);
 }
 return e;
}

function rsi(values,period=14){
 if(values.length<=period)return NaN;
 let gains=0,losses=0;
 for(let i=values.length-period;i<values.length;i++){
  let diff=values[i]-values[i-1];
  if(diff>0)gains+=diff;
  else losses-=diff;
 }
 let avgGain=gains/period;
 let avgLoss=losses/period;
 if(avgLoss===0)return 100;
 return 100-(100/(1+avgGain/avgLoss));
}

function bollinger(values,period=20){
 let arr=values.slice(-period);
 let mean=arr.reduce((a,b)=>a+b,0)/arr.length;
 let variance=arr.reduce((a,b)=>a+Math.pow(b-mean,2),0)/arr.length;
 let sd=Math.sqrt(variance);
 return {middle:mean,upper:mean+2*sd,lower:mean-2*sd};
}

async function loadPrice(){
 const data=await getJSON(API+"/fapi/v1/ticker/price?symbol=BTCUSDT");
 currentPrice=Number(data.price);
 document.getElementById("price").textContent=fmt(currentPrice,2)+" USDT";
 document.getElementById("updated").textContent=new Date().toLocaleTimeString();
}

async function loadMinute(){
 const data=await getJSON(API+"/fapi/v1/klines?symbol=BTCUSDT&interval=1m&limit=3");
 const old=Number(data[data.length-2][4]);
 const latest=Number(data[data.length-1][4]);
 const change=((latest-old)/old)*100;
 document.getElementById("change1m").textContent=fmt(change,4)+"%";
 document.getElementById("change1m").className=change>=0?"green":"red";
 lastMinutePrice=latest;
}

async function loadIndicators(){
 const data=await getJSON(API+"/fapi/v1/klines?symbol=BTCUSDT&interval=15m&limit=100");
 // آخری کینڈل ابھی جاری ہو سکتی ہے، اس لیے اسے استعمال نہیں کرتے
 const candles=data.slice(0,-1);
 const closes=candles.map(x=>Number(x[4]));
 const volumes=candles.map(x=>Number(x[5]));
 const last=closes[closes.length-1];
 const previous=closes[closes.length-2];

 const e9=ema(closes.slice(-40),9);
 const e21=ema(closes.slice(-60),21);
 const rv=rsi(closes,14);
 const bb=bollinger(closes,20);

 const avgVolume=volumes.slice(-21,-1).reduce((a,b)=>a+b,0)/20;
 const lastVolume=volumes[volumes.length-1];

 document.getElementById("ema9").textContent=fmt(e9);
 document.getElementById("ema21").textContent=fmt(e21);
 document.getElementById("rsi").textContent=fmt(rv);
 document.getElementById("bbUpper").textContent=fmt(bb.upper);
 document.getElementById("bbMiddle").textContent=fmt(bb.middle);
 document.getElementById("bbLower").textContent=fmt(bb.lower);
 document.getElementById("volume").textContent=fmt(lastVolume,3);

 let long=0,short=0;
 if(e9>e21)long++; else if(e9<e21)short++;
 if(last>e21)long++; else if(last<e21)short++;
 if(rv>50 && rv<70)long++; else if(rv<50 && rv>30)short++;
 if(last>bb.middle)long++; else if(last<bb.middle)short++;
 if(lastVolume>avgVolume && last>previous)long++;
 else if(lastVolume>avgVolume && last<previous)short++;

 let trend="Sideways";
 if(e9>e21 && last>e21)trend="Uptrend";
 if(e9<e21 && last<e21)trend="Downtrend";
 document.getElementById("trend").textContent=trend;
 document.getElementById("longScore").textContent=long+" / 6";
 document.getElementById("shortScore").textContent=short+" / 6";

 window.indicatorScores={long,short};
 window.indicatorValues={last,e9,e21,rv,bb,lastVolume,avgVolume};
}

async function loadOrderBook(){
 const data=await getJSON(API+"/fapi/v1/depth?symbol=BTCUSDT&limit=20");
 const buys=data.bids.reduce((s,x)=>s+Number(x[1]),0);
 const sells=data.asks.reduce((s,x)=>s+Number(x[1]),0);
 const total=buys+sells;
 const ratio=total?((buys-sells)/total)*100:0;

 document.getElementById("buyVol").textContent=fmt(buys,4);
 document.getElementById("sellVol").textContent=fmt(sells,4);
 document.getElementById("imbalance").textContent=fmt(ratio,2)+"%";
 let direction="Balanced";
 if(ratio>5)direction="Buyers Strong";
 if(ratio< -5)direction="Sellers Strong";
 document.getElementById("bookDirection").textContent=direction;
 window.bookRatio=ratio;
}

async function loadFutures(){
 const [oiData,fundingData]=await Promise.all([
  getJSON(API+"/fapi/v1/openInterest?symbol=BTCUSDT"),
  getJSON(API+"/fapi/v1/premiumIndex?symbol=BTCUSDT")
 ]);
 const oi=Number(oiData.openInterest);
 const funding=Number(fundingData.lastFundingRate)*100;
 document.getElementById("oi").textContent=fmt(oi,3)+" BTC";
 document.getElementById("funding").textContent=fmt(funding,5)+"%";
 let mood="Neutral";
 if(funding>0.03)mood="Longs Crowded";
 if(funding< -0.03)mood="Shorts Crowded";
 document.getElementById("fundingMood").textContent=mood;
 window.fundingRate=funding;
}

function makeSignal(){
 const scores=window.indicatorScores;
 if(!scores)return;
 let long=scores.long;
 let short=scores.short;
 const book=window.bookRatio||0;
 const funding=window.fundingRate||0;

 // Order book کی سمت اسکور کو محدود انداز میں متاثر کرتی ہے
 if(book>5)long++;
 if(book< -5)short++;

 let signal="NO TRADE";
 if(long>=5 && long-short>=2 && funding<0.08)signal="LONG";
 else if(short>=5 && short-long>=2 && funding> -0.08)signal="SHORT";

 const el=document.getElementById("signal");
 el.textContent=signal;
 el.className="signal "+(signal==="LONG"?"green":signal==="SHORT"?"red":"yellow");
 lastSignal=signal;
 document.getElementById("signalTime").textContent=new Date().toLocaleTimeString();
}

async function loadBlackRock(){
 const status=document.getElementById("ibitStatus");
 try{
  const url="https://www.blackrock.com/us/individual/products/333011/ishares-bitcoin-trust-etf/latest-holdings.csv";
  const response=await fetch(url,{cache:"no-store"});
  if(!response.ok)throw new Error("CSV unavailable");
  const csv=await response.text();
  const lines=csv.split(/\r?\n/);
  const btcRow=lines.find(line=>/BTC.*BITCOIN|BITCOIN.*BTC/i.test(line));
  if(!btcRow)throw new Error("BTC row not found");
  const cols=btcRow.split(",");
  const holdings=Number(String(cols[7]||"").replace(/"/g,"").replace(/,/g,""));
  if(!Number.isFinite(holdings)||holdings<=0)throw new Error("Holdings not parsed");

  const previous=Number(localStorage.getItem("ibit_holdings")||0);
  document.getElementById("ibitBTC").textContent=fmt(holdings,4)+" BTC";
  document.getElementById("previousBTC").textContent=previous?fmt(previous,4)+" BTC":"پہلا ریکارڈ";
  if(previous){
   const delta=holdings-previous;
   document.getElementById("ibitChange").textContent=fmt(delta,4)+" BTC";
   document.getElementById("ibitUSD").textContent=fmt(delta*currentPrice,2)+" USD";
  }else{
   document.getElementById("ibitChange").textContent="ابھی موازنہ دستیاب نہیں";
   document.getElementById("ibitUSD").textContent="--";
  }
  localStorage.setItem("ibit_holdings",String(holdings));
  status.textContent="CSV موصول ہوئی";
  status.className="green";
 }catch(e){
  status.textContent="ڈیٹا دستیاب نہیں / CORS رکاوٹ";
  status.className="yellow";
 }
}

async function refreshAll(){
 document.getElementById("connection").textContent="Updating...";
 try{
  await loadPrice();
  await loadMinute();
  await Promise.all([loadIndicators(),loadOrderBook(),loadFutures()]);
  makeSignal();
  document.getElementById("connection").textContent="Connected";
  document.getElementById("connection").className="green";
 }catch(e){
  document.getElementById("connection").textContent="Connection Error";
  document.getElementById("connection").className="red";
 }
}

refreshAll();
loadBlackRock();
setInterval(refreshAll,15000);
setInterval(loadBlackRock,1800000);
</script>
</body>
