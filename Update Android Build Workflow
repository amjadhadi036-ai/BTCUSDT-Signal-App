    <div class="grid">
      <div class="tile"><small>Balance</small><b>102 USDT</b></div>
      <div class="tile"><small>Leverage Reference</small><b>5x</b></div>
      <div class="tile"><small>Risk / Trade</small><b>0.51 USDT</b></div>
