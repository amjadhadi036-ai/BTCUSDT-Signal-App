<style>
*{box-sizing:border-box}
body{margin:0;background:#08111f;color:#e8eef8;font-family:Arial,sans-serif;padding:12px}
h2{text-align:center;color:#35c9ff;margin:8px 0}
h3{color:#35c9ff;margin:5px 0 12px}
