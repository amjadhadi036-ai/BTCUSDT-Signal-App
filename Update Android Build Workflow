.row{display:flex;justify-content:space-between;gap:8px;margin:9px 0;flex-wrap:wrap}
.value{font-weight:bold;color:#fff}
.green{color:#20df91!important}
.red{color:#ff596b!important}
.yellow{color:#ffd166!important}
.blue{color:#35c9ff!important}
