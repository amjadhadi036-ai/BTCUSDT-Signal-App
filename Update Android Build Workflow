<script>
'use strict';
const $ = id => document.getElementById(id);
const BASE = 'https://fapi.binance.com';
let soundOn = false;
let lastSignal = '';
let busy = false;
let lastIbitFetch = 0;

function ema(values, period) {
  if (!values.length) return NaN;
  const k = 2 / (period + 1);
  let value = values[0];
  for (let i = 1; i < values.length; i++) value = values[i] * k + value * (1 - k);
  return value;
}
function calcRsi(values, period = 14) {
  if (values.length <= period) return NaN;
  let gains = 0, losses = 0;
  for (let i = values.length - period; i < values.length; i++) {
    const d = values[i] - values[i - 1];
    if (d > 0) gains += d; else losses -= d;
  }
  if (losses === 0) return 100;
  const avgGain = gains / period, avgLoss = losses / period;
  return 100 - (100 / (1 + avgGain / avgLoss));
}
async function getJson(path) {
  const response = await fetch(BASE + path, {cache:'no-store'});
  if (!response.ok) throw new Error('Binance API جواب: HTTP ' + response.status);
  return response.json();
}
function beep() {
  try {
    const Ctx = window.AudioContext || window.webkitAudioContext;
    const ctx = new Ctx();
    const osc = ctx.createOscillator(), gain = ctx.createGain();
    osc.connect(gain); gain.connect(ctx.destination);
    osc.frequency.value = 880; gain.gain.value = 0.10;
    osc.start(); osc.stop(ctx.currentTime + 0.2);
    osc.onended = () => ctx.close();
  } catch (e) {}
}
function fmt(n, digits=2) {
  return Number(n).toLocaleString('en-US',{minimumFractionDigits:digits,maximumFractionDigits:digits});
}
function setText(id, value) { $(id).textContent = value; }

function parseCsvRow(line) {
  const out = [];
  let value = '', quoted = false;
  for (let i = 0; i < line.length; i++) {
    const ch = line[i];
    if (ch === '"') {
      if (quoted && line[i+1] === '"') { value += '"'; i++; }
      else quoted = !quoted;
    } else if (ch === ',' && !quoted) {
      out.push(value); value = '';
    } else value += ch;
  }
  out.push(value);
  return out;
}
function numberFromCsv(value) {
  return Number(String(value || '').replace(/,/g,'').replace(/[$%]/g,''));
}
async function loadBlackRockHoldings(btcPrice) {
  if (Date.now() - lastIbitFetch < 1800000) return;
  lastIbitFetch = Date.now();
  const csvUrl = 'https://www.blackrock.com/us/individual/products/333011/ishares-bitcoin-trust-etf/latest-holdings.csv';
  try {
    const response = await fetch(csvUrl, {cache:'no-store'});
    if (!response.ok) throw new Error('HTTP ' + response.status);
    const csv = await response.text();
    const lines = csv.split(/\r?\n/).filter(Boolean);
    const asOfLine = lines.find(line => line.startsWith('Fund Holdings as of'));
    const sharesLine = lines.find(line => line.startsWith('Shares Outstanding'));
    const btcLine = lines.find(line => line.startsWith('"BTC","BITCOIN"'));
    if (!asOfLine || !sharesLine || !btcLine) throw new Error('CSV format پہچانا نہیں جا سکا');
    const asOf = parseCsvRow(asOfLine)[1];
    const shares = numberFromCsv(parseCsvRow(sharesLine)[1]);
    const btcRow = parseCsvRow(btcLine);
    const btcUnits = numberFromCsv(btcRow[7]);
    if (!asOf || !shares || !btcUnits) throw new Error('Holdings data نامکمل ہے');

    setText('ibitDate', asOf);
    setText('ibitBtc', fmt(btcUnits,3) + ' BTC');
    setText('ibitShares', Math.round(shares).toLocaleString('en-US'));
    setText('ibitValue', '$' + fmt(btcUnits * btcPrice,0));
    $('ibitBadge').textContent = 'OFFICIAL CSV LOADED';
    $('etfStatus').textContent = 'BlackRock کے سرکاری IBIT holdings CSV سے ڈیٹا موصول ہوا۔';

    const key = 'amjad_ibit_daily_snapshot_v1';
    const current = {asOf, shares, btcUnits};
    let previous = null;
    try { previous = JSON.parse(localStorage.getItem(key) || 'null'); } catch(e) {}
    if (!previous) {
      setText('ibitFlow', 'ابتدائی baseline محفوظ کر دی گئی');
      setText('ibitFlowNote', 'اگلے نئے daily holdings snapshot پر تبدیلی کا تخمینہ دستیاب ہوگا۔');
      try { localStorage.setItem(key, JSON.stringify(current)); } catch(e) {}
    } else if (previous.asOf === asOf) {
      setText('ibitFlow', 'آج کا نیا daily snapshot ابھی نہیں آیا');
      setText('ibitFlowNote', 'محفوظ آخری snapshot: ' + previous.asOf + '۔ اسی تاریخ کے بار بار refresh کو نیا flow نہیں سمجھا جاتا۔');
    } else {
      const deltaBtc = btcUnits - Number(previous.btcUnits);
      const approxUsd = deltaBtc * btcPrice;
      const direction = approxUsd > 0 ? 'ممکنہ INFLOW' : approxUsd < 0 ? 'ممکنہ OUTFLOW' : 'کوئی تبدیلی نہیں';
      setText('ibitFlow', direction + ' · ' + (deltaBtc >= 0 ? '+' : '') + fmt(deltaBtc,3) + ' BTC');
      setText('ibitFlowNote', 'تقریبی مالیت: ' + (approxUsd >= 0 ? '+' : '-') + '$' + fmt(Math.abs(approxUsd),0) +
        ' · موازنہ ' + previous.asOf + ' سے ' + asOf + ' تک۔ BTC holdings کی تبدیلی کا تخمینہ ہے، تصدیق شدہ net cash flow نہیں۔');
      try { localStorage.setItem(key, JSON.stringify(current)); } catch(e) {}
    }
  } catch (err) {
    $('ibitBadge').textContent = 'CSV UNAVAILABLE';
    $('etfStatus').textContent = 'ایپ BlackRock CSV خودکار طور پر نہیں پڑھ سکی (' + err.message +
      ')۔ نیچے سرکاری CSV لنک کھول کر تازہ holdings دیکھی جا سکتی ہیں۔';
    setText('ibitFlow', 'خودکار ڈیٹا دستیاب نہیں');
    setText('ibitFlowNote', 'ممکن ہے Android WebView یا BlackRock کی طرف سے cross-origin پابندی ہو۔');
  }
}

async function load() {
  if (busy) return;
  busy = true;
  $('error').textContent = '';
  try {
    const [k15, k1, depth, oiData, premium, ticker] = await Promise.all([
      getJson('/fapi/v1/klines?symbol=BTCUSDT&interval=15m&limit=100'),
      getJson('/fapi/v1/klines?symbol=BTCUSDT&interval=1m&limit=3'),
      getJson('/fapi/v1/depth?symbol=BTCUSDT&limit=20'),
      getJson('/fapi/v1/openInterest?symbol=BTCUSDT'),
      getJson('/fapi/v1/premiumIndex?symbol=BTCUSDT'),
      getJson('/fapi/v1/ticker/price?symbol=BTCUSDT')
    ]);

    // آخری 15m کینڈل ابھی بن رہی ہوتی ہے، اسے سگنل کے حساب سے خارج کریں۔
    const closed15 = k15.slice(0, -1);
    if (closed15.length < 30) throw new Error('15 منٹ کا کافی تاریخی ڈیٹا نہیں ملا۔');
    const closes = closed15.map(c => Number(c[4]));
    const volumes = closed15.map(c => Number(c[5]));
    const lastCandle = closed15[closed15.length - 1];
    const signalPrice = closes[closes.length - 1];
    const livePrice = Number(ticker.price);

    const e9 = ema(closes.slice(-40), 9);
    const e21 = ema(closes.slice(-60), 21);
    const rsi = calcRsi(closes, 14);
    const recent = closes.slice(-20);
    const mean = recent.reduce((a,b)=>a+b,0) / recent.length;
    const variance = recent.reduce((a,b)=>a + (b-mean)*(b-mean),0) / recent.length;
    const sd = Math.sqrt(variance);
    const upper = mean + 2 * sd, lower = mean - 2 * sd;

    const recentVol = volumes.slice(-20);
    const avgVol = recentVol.slice(0,-1).reduce((a,b)=>a+b,0) / Math.max(1,recentVol.length-1);
    const lastVol = recentVol[recentVol.length-1];
    const volumeOk = lastVol > avgVol;

    const bids = depth.bids.slice(0,10).reduce((s,x)=>s + Number(x[0])*Number(x[1]),0);
    const asks = depth.asks.slice(0,10).reduce((s,x)=>s + Number(x[0])*Number(x[1]),0);
    const imbalance = (bids - asks) / (bids + asks || 1);

    const oi = Number(oiData.openInterest);
    const funding = Number(premium.lastFundingRate);
    const markPrice = Number(premium.markPrice);

    // ایک منٹ کی موجودہ قیمت کی نگرانی؛ آخری بند 1m کینڈل سے موازنہ۔
    const oneMinuteClosed = k1[k1.length-2];
    const oneMinutePrevious = k1[k1.length-3];
    const oneMinChange = oneMinuteClosed && oneMinutePrevious
      ? ((Number(oneMinuteClosed[4])-Number(oneMinutePrevious[4]))/Number(oneMinutePrevious[4]))*100
      : 0;

    // 15m سگنل کے لیے سخت مگر سادہ confirmation score۔
    const longChecks = [
      e9 > e21,
      signalPrice > e9,
      rsi >= 52 && rsi <= 70,
      signalPrice > mean && signalPrice < upper,
      imbalance > 0.08,
      volumeOk
    ];
    const shortChecks = [
      e9 < e21,
      signalPrice < e9,
      rsi <= 48 && rsi >= 30,
      signalPrice < mean && signalPrice > lower,
      imbalance < -0.08,
      volumeOk
    ];
    const longScore = longChecks.filter(Boolean).length;
    const shortScore = shortChecks.filter(Boolean).length;
    let signal = 'NO TRADE';
    // 6 میں سے کم از کم 5 شرائط، اور مخالف اسکور سے واضح فرق۔
    if (longScore >= 5 && longScore - shortScore >= 2) signal = 'LONG';
    if (shortScore >= 5 && shortScore - longScore >= 2) signal = 'SHORT';

    const entry = livePrice;
    let stop = null, target = null;
    if (signal === 'LONG') { stop = entry * 0.995; target = entry * 1.01; }
    if (signal === 'SHORT') { stop = entry * 1.005; target = entry * 0.99; }

    $('signal').textContent = signal;
    $('signal').className = 'signal ' + (signal==='LONG'?'green':signal==='SHORT'?'red':'yellow');
    setText('reason', signal==='NO TRADE'
      ? 'شرائط پوری نہیں ہوئیں؛ فی الحال ٹریڈ نہ لیں۔'
      : signal + ' کے حق میں ' + Math.max(longScore,shortScore) + '/6 شرائط مکمل ہیں۔');
    setText('price', fmt(livePrice,2) + ' USDT');
    setText('entry', fmt(entry,2));
    setText('sl', stop===null?'—':fmt(stop,2));
    setText('tp', target===null?'—':fmt(target,2));
    setText('strength', Math.max(longScore,shortScore) + '/6');
    setText('oneMin', (oneMinChange>=0?'+':'') + fmt(oneMinChange,3) + '%');
    setText('trend', e9>e21?'UPTREND':'DOWNTREND');
    setText('rsi', fmt(rsi,1));
    setText('ema', fmt(e9,1) + ' / ' + fmt(e21,1));
    setText('imbalance', (imbalance*100>=0?'+':'') + fmt(imbalance*100,1) + '%');
    setText('volume', volumeOk?'اوسط سے زیادہ':'اوسط سے کم');
    setText('oi', fmt(oi,3) + ' BTC');
    setText('funding', (funding*100>=0?'+':'') + fmt(funding*100,4) + '%');
    setText('updated', 'Live قیمت اپ ڈیٹ: ' + new Date().toLocaleTimeString());
    setText('candleInfo', 'آخری مکمل 15m کینڈل: ' + new Date(Number(lastCandle[6])).toLocaleTimeString());
    $('checks').innerHTML =
      'EMA 9 بمقابلہ EMA 21 <span>' + (e9>e21?'Bullish':'Bearish') + '</span><br>' +
      'RSI فلٹر <span>' + (rsi>=52&&rsi<=70?'Long موافق':rsi<=48&&rsi>=30?'Short موافق':'Neutral') + '</span><br>' +
      'Bollinger Bands <span>' + (signalPrice>mean?'وسط سے اوپر':signalPrice<mean?'وسط سے نیچے':'وسط کے قریب') + '</span><br>' +
      'Volume <span>' + (volumeOk?'تصدیق':'تصدیق نہیں') + '</span><br>' +
      'Order Book <span>' + (imbalance>0.08?'خریدار غالب':imbalance< -0.08?'فروخت کنندہ غالب':'متوازن') + '</span><br>' +
      'Open Interest <span>' + fmt(oi,3) + ' BTC</span><br>' +
      'Mark Price <span>' + fmt(markPrice,2) + '</span><br>' +
      'LONG شرائط <span>' + longScore + '/6</span><br>' +
      'SHORT شرائط <span>' + shortScore + '/6</span>';

    loadBlackRockHoldings(livePrice);
    if (soundOn && signal !== 'NO TRADE' && signal !== lastSignal) beep();
    lastSignal = signal;
    $('live').textContent = 'CONNECTED';
  } catch (err) {
    $('live').textContent = 'OFFLINE';
    $('error').textContent = 'ڈیٹا کنکشن مسئلہ: ' + err.message + '۔ انٹرنیٹ چیک کریں یا کچھ دیر بعد دوبارہ کوشش کریں۔';
  } finally {
    busy = false;
  }
}

$('sound').addEventListener('click', () => {
  soundOn = true; beep(); $('sound').textContent = '🔔 آواز آن ہے';
});
